  "private": true,
  "packageManager": "yarn@4.17.1",
  "engines": {
    "node": ">=20.19"
  },
  "resolutions": {
    "postcss": "8.5.29",
    "sharp": "0.35.5"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
