# Copy this file to .env.local and fill in the real values.
# Every variable listed here is read once, in src/services/EnvironmentService.ts.

# Public origin of the deployment, used by the sitemap, robots and canonical URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Analytics, leave empty to disable the whole tracking layer
NEXT_PUBLIC_ANALYTICS_ENABLED=false

# Transactional mail provider, leave empty to keep MailService in dry-run mode
MAIL_API_KEY=
MAIL_FROM=
MAIL_TO=
